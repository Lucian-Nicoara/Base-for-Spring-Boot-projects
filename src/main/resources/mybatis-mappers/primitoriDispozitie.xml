<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace = "com.lucian.dgaspc.mapper.PrimitoriDispozitieMapper">
	<select id = "getPrimitoriByIdDispozitie" resultType = "com.lucian.dgaspc.model.PrimitorDispozitie">
		SELECT 
			p.id,
			p.idDispozitie,
			p.idCompartiment,
			p.compartimentulAdresat,
			p.idPersoanaPrimire,
			p.persoanaPrimire,
			DATE_FORMAT(p.dataPrimirii, '%d.%m.%Y') as dataPrimirii
		FROM 
			primitori_dispozitie p
		WHERE
			p.idDispozitie = #{idDispozitie}
	</select>
	
	<insert id="postPrimitorDispozitie">
		INSERT INTO primitori_dispozitie VALUES(null, #{primitorDispozitie.idDispozitie}, #{primitorDispozitie.idCompartiment}, #{primitorDispozitie.compartimentulAdresat}, #{primitorDispozitie.idPersoanaPrimire}, #{primitorDispozitie.persoanaPrimire}, STR_TO_DATE(#{primitorDispozitie.dataPrimirii}, '%d.%m.%Y'))
	</insert>
	
	<delete id="deletePrimitorDispozitieById">
		DELETE FROM primitori_dispozitie WHERE id = #{id}
	</delete>
	
	<delete id="deleteAllPrimitoriByIdDispozitie">
		DELETE FROM primitori_dispozitie WHERE idDispozitie = #{idDispozitie}
	</delete>

</mapper>